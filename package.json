{
  "name": "arena-epv",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "build": "npm --workspace backend run build && npm --workspace frontend run build",
    "seed": "npm --workspace backend run seed",
    "db:push": "npm --workspace backend run db:push",
    "db:studio": "npm --workspace backend run db:studio"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "playwright": "^1.60.0"
  }
}
